{
  "name": "campussync",
  "private": true,
  "description": "CampusSync: React + Vite frontend (web/) with a Supabase backend (supabase/). The legacy static site lives in public/ until the switch-over.",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json",
    "test:web": "vitest run --config web/vite.config.ts",
    "test:db": "node --test \"tests/db/*.test.js\"",
    "demo:users": "node --env-file=.env scripts/create-demo-users.mjs",
    "db:bundle": "node scripts/bundle-sql.mjs",
    "check:supabase": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-supabase.mjs",
    "db:list": "supabase migration list --linked",
    "db:push:dry": "supabase db push --linked --dry-run",
    "db:push": "supabase db push --linked"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@tailwindcss/vite": "4.3.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "supabase": "2.122.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.107.1",
    "lucide-react": "1.70.0",
    "motion": "14.11.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  }
}
