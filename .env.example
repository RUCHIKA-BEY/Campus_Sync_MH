# CampusSync environment template. Copy to `.env` and fill in values.
# `.env` is git-ignored. NEVER commit real values.
#
# IMPORTANT: the frontend in public/ is plain static files with no build
# step, so it CANNOT read this file. The two PUBLIC values below are also
# placed in public/js/config.js (added in Stage 4). They are designed to
# be visible in the browser; security comes from Row Level Security.

# Public: safe in browser code
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# SECRET: local scripts only (e.g. creating demo users).
# Bypasses every RLS policy. Never put it in public/ or commit it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# SECRET: password given to the four demo accounts by `npm run demo:users`.
# At least 12 characters with letters and numbers. Only for a dev/demo project.
DEMO_PASSWORD=

# SECRET: only needed if you later use the Supabase CLI (`supabase db push`)
SUPABASE_DB_PASSWORD=

# React app (Vite). Only VITE_* variables reach the browser. PUBLIC values only.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_DEMO_MODE=true
